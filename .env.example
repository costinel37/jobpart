# Copiază acest fișier în .env și completează valorile

# Baza de date (PostgreSQL pentru producție, SQLite pentru development)
DATABASE_URL=postgresql://user:parola@localhost:5432/jobpart
# Pentru development local cu SQLite, decomentează linia de mai jos:
# DATABASE_URL=sqlite:///./joburi.db

# JWT Secret - schimbă cu o valoare aleatorie lungă!
SECRET_KEY=schimba_cu_un_secret_lung_si_aleatoriu_2024

# Email SMTP (Gmail exemplu)
MAIL_USERNAME=emailul_tau@gmail.com
MAIL_PASSWORD=parola_aplicatie_gmail
MAIL_FROM=emailul_tau@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# URL frontend (pentru linkuri în emailuri)
FRONTEND_URL=http://localhost:8000

# Completat automat de Railway dupa adaugarea plugin-ului PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Genereaza un secret random: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=pune_aici_un_secret_random_lung

# Email SMTP Gmail (App Password - 16 caractere fara spatii)
MAIL_USERNAME=emailul_tau@gmail.com
MAIL_PASSWORD=parola_aplicatie_gmail
MAIL_FROM=emailul_tau@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# URL-ul public al aplicatiei (furnizat de Railway dupa deploy)
FRONTEND_URL=https://jobpart-production.up.railway.app

# Seteaza "production" in Railway
ENVIRONMENT=production
